# Artha frontend (Next.js)
# URL of the FastAPI backend. NEXT_PUBLIC_ prefix is required for the browser
# to read it; BACKEND_URL is accepted as an alias when rendered on the server.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
BACKEND_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Optional: LLM for the AI Advisor (client-side formatting layer).
# Leave all three empty to run the default local mode: the knowledge base +
# backend data + calculation engine answer everything, no API key needed.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ARTHA_LLM_URL=
NEXT_PUBLIC_ARTHA_LLM_API_KEY=
NEXT_PUBLIC_ARTHA_LLM_MODEL=


# Artha backend (FastAPI) — see backend/.env.example
# MARKET_DATA_API_KEY=

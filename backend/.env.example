# Artha FastAPI backend
# Copy to backend/.env and fill in values. NEVER commit real keys.

# Only required if you switch MARKET_DATA_PROVIDER to a keyed provider.
# The default provider (Yahoo Finance) needs no key.
MARKET_DATA_API_KEY=

# Market data source. Supported: yahoo
MARKET_DATA_PROVIDER=yahoo

# Allowed frontend origins (comma separated) for local development.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Optional LLM layer for the Advisor -------------------------------------
# Leave AI_PROVIDER empty to run with the built-in finance knowledge layer
# (no key needed for the demo). Never commit a real key.
AI_PROVIDER=
AI_API_KEY=
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://openrouter.ai/api/v1   # any OpenAI-compatible gateway

# Artha FastAPI backend
# Copy to backend/.env and fill in values. NEVER commit real keys.

# Only required if you switch MARKET_DATA_PROVIDER to a keyed provider.
# The default provider (Yahoo Finance) needs no key.
MARKET_DATA_API_KEY=

# Market data source. Supported: yahoo
MARKET_DATA_PROVIDER=yahoo

# Allowed frontend origins (comma separated) for local development.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- AI Advisor LLM layer ---------------------------------------------------
# Google Gemini (official google-genai SDK) — the Advisor's default provider.
# Leave GEMINI_API_KEY empty to run the built-in local/rule-based Advisor
# (no key needed). The key is backend-only: it is never sent to Next.js,
# never logged and never committed. NEVER put a real key in this file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash  # gemini-2.5-flash is deprecated

# Optional: use another provider instead (leave AI_PROVIDER empty to use
# Gemini whenever GEMINI_API_KEY is set). Never commit a real key.
AI_PROVIDER=
AI_API_KEY=
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://openrouter.ai/api/v1   # any OpenAI-compatible gateway
